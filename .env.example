# ===================================================
# Knitin Portfolio — Environment Configuration
# ===================================================

# Server & Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://knitin525.in
PORT=3000

# Database Configuration (Hostinger MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_portfolio
DB_USER=u123456789_admin
DB_PASS=your_secure_db_password
DB_CHARSET=utf8mb4

# SMTP Configuration (Hostinger Outgoing Mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=contact@knitin525.in
SMTP_PASS=your_email_password_here
SMTP_FROM_NAME="Nitin Kumar"

# IMAP Configuration (Hostinger Incoming Mail)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USER=contact@knitin525.in
IMAP_PASS=your_email_password_here
IMAP_MAILBOX=INBOX

# Admin Contact & Notifications
ADMIN_EMAIL=contact@knitin525.in
ADMIN_NAME="Nitin Kumar"
ADMIN_NOTIFY=true

# Security & Cron Secret (Change to a random 32+ char string)
CRON_SECRET=replace_with_a_random_secure_cron_secret_token
CSRF_SECRET=replace_with_a_random_secure_csrf_secret_token